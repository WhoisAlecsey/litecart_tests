# Copy this file to .env and fill in the values.

# Store under test. The https version has an expired certificate and responds several times slower.
BASE_URL=http://litecart.stqa.ru

# A registered customer used by the order tests (TC1, TC2).
# Register one at http://litecart.stqa.ru/en/create_account
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# An e-mail / password pair the store rejects, used by the invalid login test (TC4).
REJECTED_EMAIL=
REJECTED_PASSWORD=
